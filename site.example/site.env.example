# mmbox site settings, read by deploy/site-deploy.sh and sent to the host with the scripts. Shell syntax.
# Copy this folder to <repository>/site (ignored by git) or anywhere (MMBOX_SITE_DIR), and fill it in.
# NEVER a secret here: passwords are made on the host and kept by secret_set (hooks.sh, or a root-only file).

# where to deploy: an ssh target with root rights (empty: this computer, with sudo)
MMBOX_SSH_TARGET=root@server.example.com

# the rootless user that owns the Quadlet units (create it once: useradd -m podman)
MMBOX_PODMAN_USER=podman

# the public name of the service, served by nginx on the host (empty: no vhost, the gateway stays on 127.0.0.1:8095)
MMBOX_DOMAIN=mmbox.example.com
# the addresses allowed to reach it, separated by spaces (your VPN, a few guests); empty: everyone
MMBOX_ALLOW="10.8.0.0/24"
# lines added to the nginx server block when the host has no default certificate
#MMBOX_NGINX_SERVER_EXTRA="ssl_certificate /etc/letsencrypt/live/mmbox.example.com/fullchain.pem;
#ssl_certificate_key /etc/letsencrypt/live/mmbox.example.com/privkey.pem;"
# a file of proxy settings included in the location, instead of the default proxy headers
#MMBOX_NGINX_INCLUDE=/etc/nginx/snippets/proxy.conf

# where the host builds the gateway from (a private repository: ssh URL and a deploy key on the host)
#MMBOX_REPO=https://github.com/lp177/mmbox.git
#MMBOX_BRANCH=master
#MMBOX_DEPLOY_KEY=/root/.ssh/mmbox_deploy

# the operator's console (mmbox_console.py --whoami) and its collector
#MMBOX_OPERATORS=m000000000000
#MMBOX_COLLECTOR=1
#MMBOX_COLLECTOR_DAYS=7

# Redis
#MMBOX_REDIS_MAXMEMORY=6gb
#MMBOX_REDIS_PORT=6390
#MMBOX_GATEWAY_PORT=8095
